<!DOCTYPE html>

<html>
  <head>
    <title>Producerflow API Documentation</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"/>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        max-width: 1224px;
        width: 90%;
        margin: 2em auto;
        color: #212629;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.6;
        letter-spacing: -0.011em;
        padding: 2em 1.5em 4em;
        background-color: #ffffff;
      }

      h1 {
        font-weight: 800;
        font-size: 2.5rem;
        line-height: 1.3;
        letter-spacing: -0.022em;
        color: #16181d;
        border-bottom: 2px solid #ebedf2;
        padding-bottom: 0.75rem;
        margin-bottom: 2rem;
      }

      h2 {
        font-weight: 700;
        font-size: 2rem;
        line-height: 1.3;
        letter-spacing: -0.022em;
        color: #16181d;
        border-bottom: 2px solid #ebedf2;
        padding-bottom: 0.75rem;
        margin: 2.5rem 0 1rem;
      }

      h3 {
        font-weight: 600;
        font-size: 1.5rem;
        line-height: 1.3;
        letter-spacing: -0.022em;
        color: #16181d;
        border-bottom: 1px solid #ebedf2;
        padding-bottom: 0.5rem;
        margin: 2rem 0 0.75rem;
      }

      h4 {
        font-weight: 600;
        font-size: 1.25rem;
        line-height: 1.3;
        color: #16181d;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
      }

      a {
        text-decoration: none;
        color: #0099ff;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      a:hover {
        color: #008ae6;
        text-decoration: underline;
      }

      table {
        width: 100%;
        font-size: 0.875rem;
        border-collapse: collapse;
        border: 1px solid #ebedf2;
      }

      thead {
        font-weight: 600;
        background-color: #f5f7fa;
        color: #16181d;
      }

      tbody tr:nth-child(even) {
        background-color: #fafbfc;
      }

      tbody tr:hover {
        background-color: #f5f7fa;
      }

      td {
        border: 1px solid #ebedf2;
        padding: 0.75rem 1rem;
      }

      td p {
        text-indent: 1em;
        margin: 0;
      }

      td p:nth-child(1) {
        text-indent: 0;
      }

      /* Table of fields */
      .field-table td:nth-child(1) {
        width: 10em;
      }
      .field-table td:nth-child(2) {
        width: 10em;
      }
      .field-table td:nth-child(3) {
        width: 6em;
      }
      .field-table td:nth-child(4) {
        width: auto;
      }

      /* Table of extensions */
      .extension-table td:nth-child(1) {
        width: 10em;
      }
      .extension-table td:nth-child(2) {
        width: 10em;
      }
      .extension-table td:nth-child(3) {
        width: 10em;
      }
      .extension-table td:nth-child(4) {
        width: 5em;
      }
      .extension-table td:nth-child(5) {
        width: auto;
      }

      /* Table of enum values. */
      .enum-table td:nth-child(1) {
        width: 10em;
      }
      .enum-table td:nth-child(2) {
        width: 10em;
      }
      .enum-table td:nth-child(3) {
        width: auto;
      }

      /* Table of scalar value types. */
      .scalar-value-types-table tr {
        height: 3em;
      }

      /* Table of contents. */
      #toc-container ul {
        list-style-type: none;
        padding-left: 1em;
        line-height: 180%;
        margin: 0;
      }
      #toc > li > a {
        font-weight: bold;
      }

      /* Service heading div */
      .service-heading {
        width: 100%;
        display: table;
        border-bottom: 2px solid #ebedf2;
        margin: 2.5rem 0 1rem 0;
      }
      .service-heading h2 {
        border: none;
        display: table-cell;
        color: #16181d;
      }
      .service-heading a {
        text-align: right;
        display: table-cell;
        font-size: 0.875rem;
      }

      /* The 'M', 'E', 'S' and 'X' badges in the ToC */
      .badge {
        width: 1.6em;
        height: 1.6em;
        display: inline-block;
        line-height: 1.6em;
        text-align: center;
        font-weight: 600;
        font-size: 0.65rem;
        color: #0099ff;
        background-color: #e6f4ff;
        margin: 0.5ex 1em 0.5ex -1em;
        border: 1px solid #b3e0ff;
        border-radius: 4px;
      }

      /* Collapsible sections */
      details {
        margin: 1.5rem 0;
        border: 1px solid #ebedf2;
        border-radius: 8px;
        background-color: #fafbfc;
        transition: all 0.2s ease;
      }

      details:hover {
        border-color: #d0d5dd;
      }

      details summary {
        padding: 1rem 1.25rem;
        cursor: pointer;
        font-weight: 600;
        background-color: #f5f7fa;
        border-radius: 8px 8px 0 0;
        user-select: none;
        list-style: none;
        color: #16181d;
        transition: background-color 0.2s ease;
      }

      details summary:hover {
        background-color: #ebedf2;
      }

      details summary::-webkit-details-marker {
        display: none;
      }

      details summary::before {
        content: "▶ ";
        display: inline-block;
        margin-right: 0.5em;
        transition: transform 0.2s;
        color: #0099ff;
        font-size: 0.875rem;
      }

      details[open] summary::before {
        transform: rotate(90deg);
      }

      details[open] {
        background-color: #fff;
      }

      details[open] summary {
        background-color: #f5f7fa;
      }

      details .details-content {
        padding: 1.25rem;
        border-top: 1px solid #ebedf2;
      }

      /* Service section styling */
      .service-section {
        margin-bottom: 3em;
      }

      /* Method details styling */
      .method-details {
        margin: 1rem 0;
      }

      .method-details summary {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .method-name {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 1rem;
        font-weight: 600;
      }

      .method-description {
        margin: 0 0 1.5rem 0;
        color: #4a5568;
        line-height: 1.7;
      }

      /* Service and type description styling */
      .description-content {
        margin: 1rem 0 2rem 0;
        color: #4a5568;
        line-height: 1.75;
        font-size: 1rem;
        white-space: pre-line;
      }

      .description-content ul,
      .description-content ol {
        margin: 0.75em 0;
        padding-left: 1.5em;
        white-space: normal;
      }

      .description-content li {
        margin: 0.5em 0;
        line-height: 1.6;
      }

      .description-content code {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 0.9em;
        background-color: #f1f5f9;
        padding: 0.15em 0.4em;
        border-radius: 3px;
        color: #1e293b;
        white-space: pre;
      }

      .description-content strong {
        font-weight: 600;
        color: #16181d;
      }

      .stream-badge {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.2em 0.5em;
        background-color: #fef3c7;
        color: #92400e;
        border-radius: 4px;
        border: 1px solid #fcd34d;
      }

      /* Message section styling */
      .message-section {
        margin: 1.5rem 0;
        padding: 1rem;
        background-color: #f8fafc;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
      }

      .message-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e2e8f0;
      }

      .message-type-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.25em 0.6em;
        border-radius: 4px;
        letter-spacing: 0.05em;
      }

      .request-label {
        background-color: #dbeafe;
        color: #1e40af;
        border: 1px solid #93c5fd;
      }

      .response-label {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
      }

      .message-type-name {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 0.95rem;
        font-weight: 500;
        color: #334155;
      }

      .message-description {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 1rem;
      }

      .message-section .field-table {
        margin: 0;
        font-size: 0.85rem;
      }

      .message-section .field-table code {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
        font-size: 0.85em;
        background-color: #f1f5f9;
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }

      .no-fields {
        font-size: 0.875rem;
        color: #94a3b8;
        font-style: italic;
        margin: 0;
      }

      /* Nested ToC styling */
      #toc > li > ul {
        margin-top: 0.25em;
        padding-left: 1.5em;
        font-size: 0.9em;
      }

      #toc > li > ul > li {
        line-height: 1.6;
      }

      #toc > li > ul > li > a {
        font-weight: 400;
        color: #64748b;
      }

      #toc > li > ul > li > a:hover {
        color: #0099ff;
      }
    </style>

    <!-- User custom CSS -->
    <link rel="stylesheet" type="text/css" href="stylesheet.css"/>
  </head>

  <body>

    <h1 id="title">Producerflow API Documentation</h1>

    <h2>Table of Contents</h2>

    <div id="toc-container">
      <ul id="toc">
        {{range .Files}}
          {{range $service := .Services}}
            <li>
              <a href="#{{.FullName}}"><span class="badge">S</span>{{.Name}}</a>
              <ul>
                {{range .Methods}}
                  <li><a href="#{{$service.FullName}}.{{.Name}}">{{.Name}}</a></li>
                {{end}}
              </ul>
            </li>
          {{end}}
        {{end}}
        <li><a href="#shared-messages">Shared Types</a></li>
        <li><a href="#enums">Enums</a></li>
      </ul>
    </div>

    {{/* First, show all services organized by service */}}
    {{range $file := .Files}}
      {{range $service := .Services}}
        <div class="service-section">
          <div class="service-heading">
            <h2 id="{{.FullName}}">{{.Name}}</h2><a href="#title">Top</a>
          </div>

          <div class="description-content">
            {{.Description}}
          </div>

          {{range $method := .Methods}}
            <details class="method-details" id="{{$service.FullName}}.{{.Name}}">
              <summary>
                <span class="method-name">{{.Name}}</span>
                {{if .RequestStreaming}}<span class="stream-badge">streaming</span>{{end}}
              </summary>
              <div class="details-content">
                <p class="method-description">{{.Description}}</p>

                {{/* Request Message */}}
                <div class="message-section">
                  <h4 class="message-header">
                    <span class="message-type-label request-label">Request</span>
                    <span class="message-type-name" id="{{.RequestFullType}}">{{.RequestLongType}}</span>
                  </h4>
                  {{range $file.Messages}}
                    {{if eq .FullName $method.RequestFullType}}
                      {{if .Description}}<p class="message-description">{{.Description}}</p>{{end}}
                      {{if .HasFields}}
                        <table class="field-table">
                          <thead>
                            <tr><td>Field</td><td>Type</td><td>Label</td><td>Description</td></tr>
                          </thead>
                          <tbody>
                            {{range .Fields}}
                              <tr>
                                <td><code>{{.Name}}</code></td>
                                <td><a href="#{{.FullType}}">{{.LongType}}</a></td>
                                <td>{{.Label}}</td>
                                <td>{{if (index .Options "deprecated"|default false)}}<strong>Deprecated.</strong> {{end}}{{.Description}} {{if .DefaultValue}}Default: {{.DefaultValue}}{{end}}</td>
                              </tr>
                            {{end}}
                          </tbody>
                        </table>
                      {{else}}
                        <p class="no-fields">This message has no fields.</p>
                      {{end}}
                    {{end}}
                  {{end}}
                </div>

                {{/* Response Message */}}
                <div class="message-section">
                  <h4 class="message-header">
                    <span class="message-type-label response-label">Response</span>
                    <span class="message-type-name" id="{{.ResponseFullType}}">{{.ResponseLongType}}</span>
                    {{if .ResponseStreaming}}<span class="stream-badge">streaming</span>{{end}}
                  </h4>
                  {{range $file.Messages}}
                    {{if eq .FullName $method.ResponseFullType}}
                      {{if .Description}}<p class="message-description">{{.Description}}</p>{{end}}
                      {{if .HasFields}}
                        <table class="field-table">
                          <thead>
                            <tr><td>Field</td><td>Type</td><td>Label</td><td>Description</td></tr>
                          </thead>
                          <tbody>
                            {{range .Fields}}
                              <tr>
                                <td><code>{{.Name}}</code></td>
                                <td><a href="#{{.FullType}}">{{.LongType}}</a></td>
                                <td>{{.Label}}</td>
                                <td>{{if (index .Options "deprecated"|default false)}}<strong>Deprecated.</strong> {{end}}{{.Description}} {{if .DefaultValue}}Default: {{.DefaultValue}}{{end}}</td>
                              </tr>
                            {{end}}
                          </tbody>
                        </table>
                      {{else}}
                        <p class="no-fields">This message has no fields.</p>
                      {{end}}
                    {{end}}
                  {{end}}
                </div>
              </div>
            </details>
          {{end}}
        </div>
      {{end}}
    {{end}}

    {{/* Show shared/nested messages that aren't direct request/response types */}}
    <h2 id="shared-messages">Shared Types</h2>
    <p>These types are used across multiple API methods.</p>
    {{range .Files}}
      {{if .HasMessages}}
        <details>
          <summary>{{.Name}} - Types</summary>
          <div class="details-content">
            {{range .Messages}}
              {{/* Skip Request/Response messages as they're shown inline */}}
              {{if not (or (hasSuffix .Name "Request") (hasSuffix .Name "Response"))}}
                <h3 id="{{.FullName}}">{{.LongName}}</h3>
                <div class="description-content">{{.Description}}</div>

                {{if .HasFields}}
                  <table class="field-table">
                    <thead>
                      <tr><td>Field</td><td>Type</td><td>Label</td><td>Description</td></tr>
                    </thead>
                    <tbody>
                      {{range .Fields}}
                        <tr>
                          <td><code>{{.Name}}</code></td>
                          <td><a href="#{{.FullType}}">{{.LongType}}</a></td>
                          <td>{{.Label}}</td>
                          <td>{{if (index .Options "deprecated"|default false)}}<strong>Deprecated.</strong> {{end}}{{.Description}} {{if .DefaultValue}}Default: {{.DefaultValue}}{{end}}</td>
                        </tr>
                      {{end}}
                    </tbody>
                  </table>
                {{end}}

                {{if .HasExtensions}}
                  <table class="extension-table">
                    <thead>
                      <tr><td>Extension</td><td>Type</td><td>Base</td><td>Number</td><td>Description</td></tr>
                    </thead>
                    <tbody>
                      {{range .Extensions}}
                        <tr>
                          <td>{{.Name}}</td>
                          <td><a href="#{{.FullType}}">{{.LongType}}</a></td>
                          <td><a href="#{{.ContainingFullType}}">{{.ContainingLongType}}</a></td>
                          <td>{{.Number}}</td>
                          <td>{{.Description}}{{if .DefaultValue}} Default: {{.DefaultValue}}{{end}}</td>
                        </tr>
                      {{end}}
                    </tbody>
                  </table>
                {{end}}
              {{end}}
            {{end}}
          </div>
        </details>
      {{end}}
    {{end}}

    {{/* Then show all enums, grouped by file, collapsed by default */}}
    <h2 id="enums">Enums</h2>
    {{range .Files}}
      {{if .HasEnums}}
        <details>
          <summary>{{.Name}} - Enums</summary>
          <div class="details-content">
            {{range .Enums}}
              <h3 id="{{.FullName}}">{{.LongName}}</h3>
              <div class="description-content">{{.Description}}</div>
              <table class="enum-table">
                <thead>
                  <tr><td>Name</td><td>Number</td><td>Description</td></tr>
                </thead>
                <tbody>
                  {{range .Values}}
                    <tr>
                      <td>{{.Name}}</td>
                      <td>{{.Number}}</td>
                      <td><p>{{.Description}}</p></td>
                    </tr>
                  {{end}}
                </tbody>
              </table>
            {{end}}
          </div>
        </details>
      {{end}}
    {{end}}

    {{/* File-level extensions */}}
    {{range .Files}}
      {{if .HasExtensions}}
        <details>
          <summary>{{.Name}} - File-level Extensions</summary>
          <div class="details-content">
            <h3 id="{{.Name}}-extensions">File-level Extensions</h3>
            <table class="extension-table">
              <thead>
                <tr><td>Extension</td><td>Type</td><td>Base</td><td>Number</td><td>Description</td></tr>
              </thead>
              <tbody>
                {{range .Extensions}}
                  <tr>
                    <td>{{.Name}}</td>
                    <td><a href="#{{.FullType}}">{{.LongType}}</a></td>
                    <td><a href="#{{.ContainingFullType}}">{{.ContainingLongType}}</a></td>
                    <td>{{.Number}}</td>
                    <td><p>{{.Description}}{{if .DefaultValue}} Default: {{.DefaultValue}}{{end}}</p></td>
                  </tr>
                {{end}}
              </tbody>
            </table>
          </div>
        </details>
      {{end}}
    {{end}}

  </body>
</html>
