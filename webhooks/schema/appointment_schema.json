{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Appointment Event Schema",
  "description": "Schema for appointment events in Producerflow",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the event"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "Type of event that occurred (e.g., 'appointment.updated', 'appointment.created')"
    },
    "origin": {
      "type": "string",
      "enum": ["ProducerFlowAPI", "ProducerFlowPortal"],
      "description": "Source of the change"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Time when the change occurred"
    },
    "appointment_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the appointment"
    },
    "producer_id": {
      "type": "string",
      "description": "Unique identifier for the producer"
    },
    "agency_id": {
      "type": "string",
      "description": "Unique identifier for the agency"
    },
    "external_agency_id": {
      "type": "string",
      "description": "External identifier for the agency"
    },
    "external_producer_id": {
      "type": "string",
      "description": "External identifier for the producer"
    },
    "agency_npn": {
      "type": "string",
      "description": "Agency National Producer Number"
    },
    "producer_npn": {
      "type": "string",
      "description": "Producer National Producer Number"
    },
    "appointment_data": {
      "type": "object",
      "description": "Core appointment information",
      "properties": {
        "carrier": {
          "type": "string",
          "description": "Insurance carrier name"
        },
        "cocode": {
          "type": "string",
          "description": "NAIC company code of the carrier"
        },
        "state": {
          "type": "string",
          "description": "State where the appointment is valid"
        },
        "status": {
          "type": "string",
          "description": "Current status of the appointment"
        },
        "license_number": {
          "type": "string",
          "description": "License number associated with the appointment"
        },
        "is_resident": {
          "type": "boolean",
          "description": "Whether the appointment is resident or non-resident"
        },
        "effective_date": {
          "type": "string",
          "format": "date-time",
          "description": "Date when the appointment became effective"
        },
        "termination_date": {
          "type": "string",
          "format": "date-time",
          "description": "Date when the appointment was terminated"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reasons for appointment termination"
        }
      }
    },
    "operational_status": {
      "type": "object",
      "description": "Operational status information for the appointment",
      "properties": {
        "previous_status": {
          "type": "string",
          "enum": ["active", "at_risk"],
          "description": "Previous operational status of the appointment"
        },
        "current_status": {
          "type": "string",
          "enum": ["active", "at_risk"],
          "description": "Current operational status of the appointment"
        },
        "at_risk_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["license_inactive", "license_expired", "eo_not_found", "eo_inactive", "eo_expired"]
          },
          "description": "Specific reasons why the appointment is considered at risk"
        },
        "changed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the operational status was changed"
        }
      }
    }
  },
  "required": ["id", "event_type", "origin", "timestamp", "appointment_id"],
  "additionalProperties": false
}
